rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    // Papel do utilizador (users/{uid}.role); '' se não tiver perfil.
    function getRole() {
      return (isAuth()
              && exists(/databases/$(database)/documents/users/$(request.auth.uid)))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : '';
    }

    function isAdmin() {
      return getRole() == 'admin';
    }

    // Pode escrever = autenticado e NÃO é viewer (só-leitura).
    // Utilizadores sem perfil mantêm permissão de escrita (compatibilidade).
    function canWrite() {
      return isAuth() && getRole() != 'viewer';
    }

    function isOwner(userId) {
      return isAuth() && request.auth.uid == userId;
    }

    // ── Utilizadores ──────────────────────────────────────────
    match /users/{userId} {
      allow read:                   if isOwner(userId) || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // ── Incidentes ────────────────────────────────────────────
    // Segurança real: userId obrigatoriamente == utilizador autenticado
    // Impede impersonação e garante rastreabilidade
    match /incidents/{incidentId} {
      allow read:   if isAuth();
      allow create: if canWrite()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.keys().hasOnly([
                         'partNo','partName','model','orderNo','lotNo','ngQty','defect',
                         'detected','carNum','incidentType','photos','user','userId',
                         'updatedAt','status','createdAt','history'])
                    && request.resource.data.partName is string
                    && request.resource.data.partName.size() < 300
                    && request.resource.data.photos is list
                    && request.resource.data.history is list;
      allow update: if canWrite()
                    && (isOwner(resource.data.userId) || isAdmin())
                    // Só campos conhecidos — impede injeção de campos arbitrários.
                    // Cobre create + campos adicionados em updates + legado (chassisNote).
                    && request.resource.data.keys().hasOnly([
                         'partNo','partName','model','orderNo','lotNo','ngQty','defect',
                         'detected','carNum','incidentType','photos','user','userId',
                         'updatedAt','status','createdAt','history',
                         'sentAt','eta','tracking','receivedAt','completedAt',
                         'carGeneratedAt','chassisNote'])
                    && (!('userId' in request.resource.data)
                        || request.resource.data.userId == resource.data.userId)
                    && (!('createdAt' in request.resource.data)
                        || request.resource.data.createdAt == resource.data.createdAt)
                    // 'eta_confirmed' é exclusivo do admin (confirmação de ETA da China).
                    // Não-admin pode editar um incidente que JÁ está nesse status,
                    // mas não pode TRANSICIONAR para ele.
                    && (isAdmin()
                        || request.resource.data.status != 'eta_confirmed'
                        || resource.data.status == 'eta_confirmed');
      allow delete: if canWrite()
                    && (isOwner(resource.data.userId) || isAdmin());
    }

    // ── Numeração CAR ─────────────────────────────────────────
    match /carNumbers/{docId} {
      allow read:          if isAuth();
      allow create:        if canWrite()
                           && request.resource.data.keys().hasOnly(['year','num','createdAt']);
      allow update, delete: if isAdmin();
    }

    // ── Base de peças (partsDB) ───────────────────────────────
    match /partsDB/{partId} {
      allow read:  if isAuth();
      allow write: if isAdmin();
    }

    // ── Lotes (lotNo → pedido manual) ─────────────────────────
    match /lotsDB/{lotId} {
      allow read:  if isAuth();
      allow write: if isAdmin();
    }

    // ── Stock ─────────────────────────────────────────────────
    match /stock/{partId} {
      allow read:  if isAuth();
      allow write: if canWrite()
                   && request.resource.data.keys().hasOnly([
                        'partNo','partName','qty','updatedAt','updatedBy'])
                   && request.resource.data.qty is number;
    }

    // ── Movimentos de stock ───────────────────────────────────
    match /stockMovements/{moveId} {
      allow read:   if isAuth();
      allow create: if canWrite()
                    && request.resource.data.keys().hasOnly([
                         'partNo','partName','type','qty','qtyBefore','qtyAfter',
                         'incidentId','carNum','date','user','note'])
                    && request.resource.data.qty is number
                    && request.resource.data.type in ['in','out','adjust'];
      allow delete: if isAdmin();
    }

  }
}
